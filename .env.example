# Tenet Components — read-only Supabase access
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored;
# never commit real credentials.

# PostgREST base URL for the project (no trailing slash)
SUPABASE_URL=https://klfagxxfgdrwciwoetak.supabase.co/rest/v1

# Supabase anon API key (the `apikey` header)
SUPABASE_ANON_KEY=

# Scoped read-only JWT issued for Tenet Components (the `Authorization: Bearer` token)
SUPABASE_READONLY_JWT=

# Optional: default brand_id to scope queries to (recommended for large tables).
# Leave empty to rely on RLS only.
DEFAULT_BRAND_ID=1
